    {
      "confidence": "High",
      "finding": "Denver were a good team, but 14 wins overstated their underlying level.",
      "evidence": "Points and efficiency both say about 11 wins; 20,000 simulated seasons put the middle 80% at 9\u201314, and 14+ wins in 15%. Only 2.2% of team-seasons since 2015 beat an out-of-sample efficiency forecast by as much."
    },
    {
      "confidence": "High",
      "finding": "An 11-2 one-score record is not a reliable baseline for future seasons.",
      "evidence": "Close-game win % barely repeats (r = 0.08); the 10 teams most like Denver 2025 won 49% of close games the next year and 9 of 10 won fewer games; the same coach and QB went 1-6 in close games in 2024."
    },
    {
      "confidence": "Moderate",
      "finding": "Denver's fourth-quarter success was less repeatable than its overall efficiency.",
      "evidence": "Across teams, 4th-quarter defence repeats at r = 0.13 and QB late & close at r = 0.16, against 0.41 for efficiency. Adding last season's late-game numbers to a close-game model did not improve its out-of-sample predictions (log loss 0.68704 with them vs 0.68698 without; lower is better)."
    },
    {
      "confidence": "Moderate",
      "finding": "The underlying quality came mainly from the defence.",
      "evidence": "Defence ranked #1 in success rate allowed and #1 in red-zone TD rate allowed; the offence was #13 in EPA per play."
    },
    {
      "confidence": "Still uncertain",
      "finding": "How the roughly 3 extra wins split between chance, coaching, quarterback execution and other situational factors.",
      "evidence": "Chance plays explain none of them (they went slightly against Denver), but the data can't separate repeatable late-game skill from a hot streak in one season; the 2026 start (4-0 in close games) is too short to settle it."
    }
